{
  "name": "manajemen-sekolah-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "postinstall": "bun scripts/copy-face-models.ts",
    "dev": "next dev --webpack",
    "dev:desktop": "bun scripts/dev-target.ts",
    "build": "bun run build:web",
    "build:web": "bun scripts/build-target.ts web",
    "build:desktop": "bun scripts/build-target.ts desktop",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:preview": "tauri dev --config src-tauri/tauri.preview.conf.json --no-watch",
    "tauri:build": "tauri build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "bun scripts/run-tests.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:quick": "bun run lint && bun run typecheck && bun run test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:rust",
    "bootstrap:superadmin": "bun scripts/bootstrap-superadmin.ts",
    "reset:superadmin": "bun scripts/reset-superadmin.ts",
    "migrate-old-db": "bun scripts/migrate-old-db.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@react-three/fiber": "9.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@vladmandic/human": "3.3.6",
    "@zxing/browser": "0.2.1",
    "clsx": "2.1.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "motion": "14.6.0",
    "next": "16.4.3",
    "postcss": "^8.5.31",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "undici": "^8.12.2",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "1.4.4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "18.0.9",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
